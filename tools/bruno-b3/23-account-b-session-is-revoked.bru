meta {
  name: Account B session is revoked
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{tokenB}}
}

settings {
  followRedirects: false
}

tests {
  test("Account B session is revoked", function () {
    expect(res.getStatus()).to.equal(401);
    expect(Boolean(res.getHeader("x-request-id"))).to.equal(true);
    expect(res.getHeader("content-type")).to.include("application/problem+json");
    expect(res.getBody().status).to.equal(401);
  });
}
