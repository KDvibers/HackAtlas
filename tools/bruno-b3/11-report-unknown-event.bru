meta {
  name: Report unknown event
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/hackathons/00000000-0000-0000-0000-000000000001/reports
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{tokenA}}
}

body:json {
  {"reason":"DATES","message":"DEMO: please verify the event dates."}
}

settings {
  followRedirects: false
}

tests {
  test("Report unknown event", function () {
    expect(res.getStatus()).to.equal(404);
    expect(Boolean(res.getHeader("x-request-id"))).to.equal(true);
    expect(res.getHeader("content-type")).to.include("application/problem+json");
    expect(res.getBody().status).to.equal(404);
  });
}
