meta {
  name: Suggest event for moderation
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/suggestions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{tokenA}}
}

body:json {
  {"url":"https://example.com/bruno-b3-demo","comment":"DEMO suggestion for moderation."}
}

settings {
  followRedirects: false
}

tests {
  test("Suggest event for moderation", function () {
    expect(res.getStatus()).to.equal(202);
    expect(Boolean(res.getHeader("x-request-id"))).to.equal(true);
    expect(res.getBody().status).to.equal("PENDING");
    expect(typeof res.getBody().id).to.equal("string");
  });
}
