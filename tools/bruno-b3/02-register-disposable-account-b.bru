meta {
  name: Register disposable account B
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {"email":"{{process.env.HACKATLAS_B3_EMAIL_B}}","password":"{{process.env.HACKATLAS_B3_PASSWORD}}","displayName":"Bruno B3 B"}
}

settings {
  followRedirects: false
}

tests {
  test("Register disposable account B", function () {
    expect(res.getStatus()).to.equal(201);
    expect(Boolean(res.getHeader("x-request-id"))).to.equal(true);
    expect(res.getHeader("cache-control")).to.include("no-store");
    expect(res.getBody().tokenType).to.equal("Bearer");
    expect(res.getBody().accessToken.length >= 32).to.equal(true);
    bru.setVar("tokenB", res.getBody().accessToken);
  });
}
