meta {
  name: Delete disposable account B
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/me/delete-account
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{tokenB}}
}

body:json {
  {"password":"{{process.env.HACKATLAS_B3_PASSWORD}}"}
}

settings {
  followRedirects: false
}

tests {
  test("Delete disposable account B", function () {
    expect(res.getStatus()).to.equal(204);
    expect(Boolean(res.getHeader("x-request-id"))).to.equal(true);
  });
}
