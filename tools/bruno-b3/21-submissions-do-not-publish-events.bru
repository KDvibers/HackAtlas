meta {
  name: Submissions do not publish events
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/hackathons
  body: none
  auth: none
}

settings {
  followRedirects: false
}

tests {
  test("Submissions do not publish events", function () {
    expect(res.getStatus()).to.equal(200);
    expect(Boolean(res.getHeader("x-request-id"))).to.equal(true);
    expect(res.getBody().totalElements).to.equal(5);
    expect(res.getBody().items.every(item => item.isDemo === true)).to.equal(true);
  });
}
