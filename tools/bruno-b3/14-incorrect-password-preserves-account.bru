meta {
  name: Incorrect password preserves account
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{tokenA}}
}

settings {
  followRedirects: false
}

tests {
  test("Incorrect password preserves account", function () {
    expect(res.getStatus()).to.equal(200);
    expect(Boolean(res.getHeader("x-request-id"))).to.equal(true);
    expect(res.getBody().displayName).to.equal("Bruno B3 A");
  });
}
