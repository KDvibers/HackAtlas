meta {
  name: Reject incorrect deletion password
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/me/delete-account
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{tokenA}}
}

body:json {
  {"password":"{{process.env.HACKATLAS_B3_PASSWORD}}-wrong"}
}

settings {
  followRedirects: false
}

tests {
  test("Reject incorrect deletion password", function () {
    expect(res.getStatus()).to.equal(401);
    expect(Boolean(res.getHeader("x-request-id"))).to.equal(true);
    expect(res.getHeader("content-type")).to.include("application/problem+json");
    expect(res.getBody().status).to.equal(401);
  });
}
