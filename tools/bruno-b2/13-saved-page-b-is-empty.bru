meta {
  name: Saved page B is empty
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/me/saved
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{tokenB}}
}

settings {
  followRedirects: false
}

tests {
  test("Saved page B is empty", function () {
    expect(res.getStatus()).to.equal(200);
    expect(Boolean(res.getHeader("x-request-id"))).to.equal(true);
    expect(res.getBody().items).to.have.lengthOf(0);
  });
}
