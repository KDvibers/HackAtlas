meta {
  name: Bookmark page is empty
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/me/saved
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{tokenA}}
}

settings {
  followRedirects: false
}

tests {
  test("Bookmark page is empty", function () {
    expect(res.getStatus()).to.equal(200);
    expect(Boolean(res.getHeader("x-request-id"))).to.equal(true);
    expect(res.getBody().totalElements).to.equal(0);
  });
}
