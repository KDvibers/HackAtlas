meta {
  name: Profile B remains separate
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/me
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{tokenB}}
}

settings {
  followRedirects: false
}

tests {
  test("Profile B remains separate", function () {
    expect(res.getStatus()).to.equal(200);
    expect(Boolean(res.getHeader("x-request-id"))).to.equal(true);
    expect(res.getBody().displayName).to.equal("Bruno B");
    expect(res.getBody().interests).to.have.lengthOf(0);
  });
}
