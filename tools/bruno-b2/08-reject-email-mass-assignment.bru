meta {
  name: Reject email mass assignment
  type: http
  seq: 8
}

patch {
  url: {{baseUrl}}/me
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{tokenA}}
}

body:json {
  {"email":"not-editable@example.com"}
}

settings {
  followRedirects: false
}

tests {
  test("Reject email mass assignment", function () {
    expect(res.getStatus()).to.equal(400);
    expect(Boolean(res.getHeader("x-request-id"))).to.equal(true);
    expect(res.getHeader("content-type")).to.include("application/problem+json");
    expect(res.getBody().status).to.equal(400);
  });
}
