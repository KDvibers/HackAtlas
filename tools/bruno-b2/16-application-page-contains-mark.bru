meta {
  name: Application page contains mark
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/me/applications
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{tokenA}}
}

settings {
  followRedirects: false
}

tests {
  test("Application page contains mark", function () {
    expect(res.getStatus()).to.equal(200);
    expect(Boolean(res.getHeader("x-request-id"))).to.equal(true);
    expect(res.getBody().totalElements).to.equal(1);
    expect(res.getBody().items[0].selfReported).to.equal(true);
  });
}
