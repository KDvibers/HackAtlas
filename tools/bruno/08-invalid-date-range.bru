meta {
  name: Error - reversed start date range
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/hackathons?startsFrom=2026-12-01&startsTo=2026-11-01
  body: none
  auth: none
}

tests {
  test("README cross-field date constraint is enforced", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().code).to.equal("VALIDATION_ERROR");
    expect(res.getBody().requestId).to.be.a("string").and.not.empty;
  });
}
