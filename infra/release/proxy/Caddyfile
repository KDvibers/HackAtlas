{
	admin off
	http_port 8080
	https_port 8443
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
	log default {
		output stdout
		format filter {
			wrap json
			fields {
				request delete
			}
		}
	}
}

http://{$HACKATLAS_SITE}:8080 {
	handle /__proxy_health {
		respond "ok" 200
	}
	handle {
		redir https://{$HACKATLAS_SITE}{uri} 308
	}
}

https://{$HACKATLAS_SITE}:8443 {
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy app:8080 {
		header_up -Forwarded
		header_up -X-Forwarded-For
		header_up -X-Forwarded-Proto
		header_up -X-Forwarded-Host
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}
